    \u0634\u0645\u0627 \u0628\u0647 \u0634\u0631\u06A9\u062A \u062F\u0631 \u067E\u0698\u0648\u0647\u0634.\r\n\r\n\u0628\u0631\u0627\u0633\u0627\u0633
    \u067E\u0627\u0633\u062E\u200C\u0647\u0627\u06CC \u0627\u0631\u0627\u0626\u0647\u200C\u0634\u062F\u0647\u060C
    \u0634\u0631\u0627\u06CC\u0637 \u0648\u0631\u0648\u062F \u0628\u0647 \u0627\u06CC\u0646
    \u0645\u0637\u0627\u0644\u0639\u0647 \u0631\u0627 \u0646\u062F\u0627\u0631\u06CC\u062F.\r\n\u0647\u06CC\u0686
    \u0627\u0637\u0644\u0627\u0639\u0627\u062A\u06CC \u0627\u0632 \u0628\u0627\u0632\u06CC
    \u0628\u0631\u0627\u06CC \u0634\u0645\u0627 \u062B\u0628\u062A \u0646\u062E\u0648\u0627\u0647\u062F
    \u0634\u062F."
  fixTags: 1
  forceFix: 0
