  originalText: "\u062A\u062C\u0631\u0628\u0647 \u0631\u0627\u0646\u0646\u062F\u06AF\u06CC
    \u0648 \u062C\u0633\u062A\u200C\u0648\u062C\u0648 \u06CC\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
    \u0627\u0632 \u067E\u0627\u0631\u06A9 \u062D\u0627\u0634\u06CC\u0647\u200C\u0627\u06CC
    \u062F\u0631 \u0645\u062D\u062F\u0648\u062F\u0647 \u062F\u0631\u0628 \u06F2 (\u062F\u0631\u0628
    \u0645\u0644\u062A) \u062F\u0627\u0646\u0634\u06AF\u0627\u0647 \u0639\u0644\u0645
    \u0648 \u0635\u0646\u0639\u062A \u0627\u06CC\u0631\u0627\u0646 \u0631\u0627 \u062F\u0627\u0631\u0645."
