  originalText: "\u0627\u06AF\u0631 \u0627\u0632 \u062A\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647
    \u06CC\u0627 \u062A\u0628\u0644\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647
    \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F\u060C \u0644\u0637\u0641\u0627\u064B
    \u062F\u0633\u062A\u06AF\u0627\u0647 \u062E\u0648\u062F \u0631\u0627 \u0628\u0647
    \u062D\u0627\u0644\u062A \u0627\u0641\u0642\u06CC \u0628\u0686\u0631\u062E\u0627\u0646\u06CC\u062F.\r\n\r\n\u0627\u06AF\u0631
    \u0627\u0632 \u0644\u067E\u200C\u062A\u0627\u067E \u06CC\u0627 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631
    \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F\u060C
    \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F \u0628\u0647\u062A\u0631 \u0648 \u062A\u062C\u0631\u0628\u0647
    \u0645\u0646\u0627\u0633\u0628\u200C\u062A\u0631\u060C \u0631\u0648\u06CC \u0622\u06CC\u06A9\u0648\u0646
    \u062A\u0645\u0627\u0645\u200C\u0635\u0641\u062D\u0647 \u062F\u0631 \u06AF\u0648\u0634\u0647
    \u067E\u0627\u06CC\u06CC\u0646 \u0633\u0645\u062A \u0631\u0627\u0633\u062A        
    \u06A9\u0644\u06CC\u06A9 \u06A9\u0646\u06CC\u062F.\r\n\r\n\u0633\u067E\u0633
    \u0628\u0631\u0627\u06CC \u0627\u062F\u0627\u0645\u0647\u060C \u062F\u06A9\u0645\u0647
    \u0632\u06CC\u0631 \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u062F."
