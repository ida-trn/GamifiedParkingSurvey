  originalText: "\u062F\u0631 \u0645\u0631\u0627\u062C\u0639\u0647\u200C\u0647\u0627\u06CC
    \u0645\u0639\u0645\u0648\u0644 \u062E\u0648\u062F \u0628\u0647 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
    \u0639\u0644\u0645 \u0648 \u0635\u0646\u0639\u062A \u0627\u06CC\u0631\u0627\u0646\u060C
    \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062E\u0648\u062F\u0631\u0648\u06CC
    \u062E\u0648\u062F \u0631\u0627 \u062F\u0631 \u06A9\u062F\u0627\u0645 \u062E\u06CC\u0627\u0628\u0627\u0646
    \u06CC\u0627 \u062E\u06CC\u0627\u0628\u0627\u0646\u200C\u0647\u0627\u06CC \u0627\u0637\u0631\u0627\u0641
    \u062F\u0631\u0628 \u0634\u0645\u0627\u0631\u0647 \u06F2 \u067E\u0627\u0631\u06A9
    \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F\u061F \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
    \u0628\u06CC\u0634 \u0627\u0632 \u06CC\u06A9 \u06AF\u0632\u06CC\u0646\u0647 \u0631\u0627
    \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u062F."
  fixTags: 1
  forceFix: 0
