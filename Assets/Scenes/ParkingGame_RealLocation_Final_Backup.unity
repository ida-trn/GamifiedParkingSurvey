    \u0644\u062D\u0638\u0647 \u0632\u0645\u0627\u0646 \u0628\u0628\u0631\u062F."
  successTitle: "\u0633\u067E\u0627\u0633 \u0627\u0632 \u0645\u0634\u0627\u0631\u06A9\u062A
    \u0634\u0645\u0627"
  successMessage: "\u0627\u0632 \u0645\u0634\u0627\u0631\u06A9\u062A \u0634\u0645\u0627
    \u062F\u0631 \u0627\u06CC\u0646 \u0646\u0638\u0631\u0633\u0646\u062C\u06CC \u0633\u067E\u0627\u0633\u06AF\u0632\u0627\u0631\u06CC\u0645.\n\n\u067E\u0627\u0633\u062E\u200C\u0647\u0627\u06CC
