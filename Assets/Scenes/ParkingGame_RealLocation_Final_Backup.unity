  originalText: "\u062F\u0631 \u0627\u0628\u062A\u062F\u0627\u06CC \u0647\u0631 \u0633\u0646\u0627\u0631\u06CC\u0648\u060C
    \u0627\u06CC\u0646 \u067E\u0646\u0644 \u0646\u0645\u0627\u06CC\u0634 \u062F\u0627\u062F\u0647
    \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A\u06CC
    \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F
    \u06A9\u0647 \u0647\u0646\u06AF\u0627\u0645 \u0627\u0646\u062A\u062E\u0627\u0628
    \u0645\u062D\u0644 \u067E\u0627\u0631\u06A9 \u0628\u0627\u06CC\u062F \u062F\u0631
    \u0646\u0638\u0631 \u0628\u06AF\u06CC\u0631\u06CC\u062F.\n\u062F\u0648 \u0645\u0631\u062D\u0644\u0647
    \u062A\u0645\u0631\u06CC\u0646\u06CC \u0628\u0639\u062F\u06CC \u0641\u0642\u0637
    \u0628\u0631\u0627\u06CC \u0622\u0634\u0646\u0627\u06CC\u06CC \u0628\u0627 \u0646\u062D\u0648\u0647
    \u06A9\u0627\u0631 \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632 \u062F\u0631
    \u062F\u0648 \u062D\u0627\u0644\u062A \u0647\u0633\u062A\u0646\u062F \u0648 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0647\u0627
    \u0648 \u0646\u062A\u0627\u06CC\u062C \u0622\u0646\u200C\u0647\u0627 \u062F\u0631
    \u062F\u0627\u062F\u0647\u200C\u0647\u0627\u06CC \u067E\u0698\u0648\u0647\u0634
    \u062B\u0628\u062A \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F. \u0645\u0631\u0627\u062D\u0644
    \u0627\u0635\u0644\u06CC \u0628\u0639\u062F \u0627\u0632 \u0627\u06CC\u0646 \u062F\u0648
    \u0645\u0631\u062D\u0644\u0647 \u0634\u0631\u0648\u0639 \u062E\u0648\u0627\u0647\u0646\u062F
    \u0634\u062F."
  fixTags: 1
  forceFix: 0
